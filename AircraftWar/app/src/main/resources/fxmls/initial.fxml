<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<AnchorPane prefHeight="768.0" prefWidth="512.0" styleClass="menu-screen" stylesheets="@../styles/menu.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.hitsz.ui.InitialController">
    <children>
        <Circle layoutX="-58.0" layoutY="160.0" radius="170.0" styleClass="ambient-ring" />
        <Circle layoutX="530.0" layoutY="610.0" radius="205.0" styleClass="ambient-ring" />
        <VBox alignment="CENTER" prefHeight="680.0" prefWidth="432.0" spacing="15.0" AnchorPane.bottomAnchor="42.0" AnchorPane.leftAnchor="40.0" AnchorPane.rightAnchor="40.0" AnchorPane.topAnchor="42.0">
            <children>
                <Label styleClass="screen-overline" text="HITSZ  /  ARCADE FLIGHT" />
                <Label styleClass="screen-title" text="AIR WARS" />
                <Label styleClass="screen-subtitle" text="DEFEND THE SKY. SURVIVE THE WAVES." />

                <VBox alignment="CENTER_LEFT" maxWidth="390.0" spacing="9.0" styleClass="status-card">
                    <children>
                        <Label styleClass="card-caption" text="CURRENT MISSION MODE" />
                        <Label fx:id="difficultyLayout" styleClass="mode-value" text="PEACEFUL" />
                        <Button fx:id="chooseDifficulty" mnemonicParsing="false" onAction="#switchToDifficultyChoice" prefHeight="46.0" prefWidth="348.0" styleClass="secondary-button" text="CHANGE DIFFICULTY" />
                    </children>
                </VBox>

                <Button fx:id="start" mnemonicParsing="false" onAction="#switchToGame" prefHeight="62.0" prefWidth="348.0" styleClass="primary-button" text="LAUNCH MISSION  ›" />
                <Label styleClass="control-hint" text="MOUSE TO MOVE   •   AUTO FIRE" />
                <Label styleClass="footer-note" text="AIRCRAFT WAR  /  COURSE PROJECT  /  JZWXZ" />
            </children>
        </VBox>
    </children>
</AnchorPane>
