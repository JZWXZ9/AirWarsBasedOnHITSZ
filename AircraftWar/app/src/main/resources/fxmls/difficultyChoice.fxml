<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>


<AnchorPane prefHeight="768.0" prefWidth="512.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.hitsz.ui.DifficultyController">
   <children>
      <Label alignment="CENTER" layoutX="31.0" layoutY="51.0" prefWidth="450.0" text="Please Choose The Difficulty">
         <font>
            <Font size="30.0" />
         </font>
      </Label>
      <Button fx:id="Peaceful" layoutX="196.0" layoutY="180.0" mnemonicParsing="false" onAction="#setDifficultyPeaceful" prefWidth="120.0" text="Peaceful">
         <font>
            <Font size="20.0" />
         </font>
      </Button>
      <Button fx:id="Easy" layoutX="196.0" layoutY="320.0" mnemonicParsing="false" onAction="#setDifficultyEasy" prefWidth="120.0" text="Easy">
         <font>
            <Font size="20.0" />
         </font>
      </Button>
      <Button fx:id="Normal" layoutX="196.0" layoutY="460.0" mnemonicParsing="false" onAction="#setDifficultyNormal" prefWidth="120.0" text="Normal">
         <font>
            <Font size="20.0" />
         </font>
      </Button>
      <Button fx:id="Hard" layoutX="196.0" layoutY="600.0" mnemonicParsing="false" onAction="#setDifficultyHard" prefWidth="120.0" text="Hard">
         <font>
            <Font size="20.0" />
         </font>
      </Button>
   </children>
</AnchorPane>
